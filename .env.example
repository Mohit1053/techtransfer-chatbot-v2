# TechTransfer Chatbot - Environment Configuration
# Copy this file to .env and add your actual API keys

# =============================================================================
# Google Gemini API Keys
# =============================================================================
# Add your Google API keys (comma-separated for multiple keys)
# Get keys from: https://makersuite.google.com/app/apikey

GOOGLE_API_KEYS=your-api-key-1,your-api-key-2,your-api-key-3

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# Requests per minute per key
RATE_LIMIT_RPM=60

# Cool-down period in seconds after rate limit hit
COOLDOWN_SECONDS=60

# =============================================================================
# Application Settings
# =============================================================================

# Output directory for reports
OUTPUT_DIR=output

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum concurrent workers for Q&A generation
MAX_QA_WORKERS=8
